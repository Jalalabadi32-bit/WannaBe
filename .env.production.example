# ─── WANNABE Production Environment Configuration ───────────────────────
# Copy this file to .env before starting the production stack:
#   cp .env.production.example .env
#
# IMPORTANT: Generate new, random secrets for production!
#   openssl rand -hex 32

# ─── Public Domain & TLS ────────────────────────────────────────────────
# Your fully qualified domain name pointing to this server (e.g., scanner.example.com)
DOMAIN_NAME=scanner.example.com

# Contact email for Let's Encrypt certificate renewal and expiry notifications
SSL_EMAIL=admin@example.com

# ─── Security & Authentication (MANDATORY IN PRODUCTION) ─────────────────
# Generate with: openssl rand -hex 32
# If left as default, the Fastify API Gateway will refuse to start in production.
JWT_SECRET=replace-with-64-character-random-hex-string
WANNABE_API_KEY=replace-with-strong-random-api-key

# Redis cache password
# Generate with: openssl rand -hex 24
REDIS_PASSWORD=replace-with-random-redis-password

# ─── CORS Allowed Origins ────────────────────────────────────────────────
# Comma-separated list of trusted web origins allowed to query the API
CORS_ORIGIN=https://scanner.example.com

# ─── Ollama / AI Inference ───────────────────────────────────────────────
# Default model to download and run via Ollama (Gemma 3/4)
WANNABE_MODEL=gemma3:4b

# Set to 1 if you have already pre-pulled the model into Docker volumes
WANNABE_SKIP_MODEL_PULL=0

# ─── Ports ───────────────────────────────────────────────────────────────
# In production, only the Nginx Reverse Proxy publishes ports:
#   Port 80:  HTTP (ACME Webroot Challenge + HTTPS Redirection)
#   Port 443: HTTPS (Modern TLS 1.2/1.3 + HSTS)
#
# Internal services (Fastify API, Redis, Ollama) have NO public host ports.
# Prometheus is bound strictly to host loopback at 127.0.0.1:9090.
