# WANNABE Docker Environment Configuration
# Copy this file to .env and adjust values as needed.

# ─── Security ────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-random-secret
WANNABE_API_KEY=change-me-to-a-random-api-key

# ─── Ollama / AI ─────────────────────────────────────────────
# Model to auto-pull on first boot (set WANNABE_SKIP_MODEL_PULL=1 to skip)
WANNABE_MODEL=gemma3:4b
WANNABE_SKIP_MODEL_PULL=0

# ─── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ─── Ports (host:container) ──────────────────────────────────
# Frontend:   http://localhost:8080
# API:        http://localhost:3000  (also proxied through frontend)
# Ollama:     http://localhost:11434
# Prometheus: http://localhost:9090
