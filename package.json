{
  "name": "wannabe",
  "version": "0.1.0",
  "private": true,
  "description": "Trust the Source. Verify the Package. Automated Software Supply Chain Security & Source-to-Package Verification Engine.",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev:frontend": "npm run dev --workspace=@wannabe/frontend",
    "build:frontend": "npm run build --workspace=@wannabe/frontend",
    "typecheck": "tsc -b",
    "test": "vitest run --passWithNoTests",
    "clean": "rimraf packages/*/dist packages/*/tsconfig.tsbuildinfo"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^1.6.1",
    "rimraf": "^5.0.7",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
