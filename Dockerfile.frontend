# Stage 1: Build React frontend
FROM node:22-alpine AS builder

WORKDIR /app

# Install build dependencies (package manifests first for layer caching)
COPY package.json package-lock.json tsconfig.base.json tsconfig.json ./
COPY packages/shared/package.json ./packages/shared/
COPY packages/frontend/package.json ./packages/frontend/

RUN npm ci

# Copy source and build frontend workspace
COPY packages/shared ./packages/shared
COPY packages/frontend ./packages/frontend
RUN npm run build --workspace=@wannabe/shared && npm run build --workspace=@wannabe/frontend

# Stage 2: Serve with Hardened Nginx
FROM nginx:1.27-alpine AS runner

# Install openssl for fallback certificate generation
RUN apk add --no-cache openssl

# Remove default Nginx site
RUN rm /etc/nginx/conf.d/default.conf

# Copy custom Nginx config and entrypoint
COPY deploy/nginx.conf /etc/nginx/conf.d/wannabe.conf
COPY deploy/docker-entrypoint.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh

# Copy built frontend assets
COPY --from=builder /app/packages/frontend/dist /usr/share/nginx/html

# Expose HTTP and HTTPS
EXPOSE 80 443

HEALTHCHECK --interval=15s --timeout=5s --retries=3 \
  CMD wget -qO- --no-check-certificate https://localhost/readyz || wget -qO- http://localhost/ || exit 1

ENTRYPOINT ["/docker-entrypoint.sh"]
CMD ["nginx", "-g", "daemon off;"]
