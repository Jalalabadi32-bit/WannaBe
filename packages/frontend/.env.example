# ─── Vercel / Frontend Environment Configuration ────────────────────────
# In your Vercel Project Settings > Environment Variables, configure:

# Render API endpoint (e.g. https://wannabe-api.onrender.com)
VITE_API_BASE_URL=https://wannabe-api.onrender.com

# API Key matching WANNABE_API_KEY generated in Render
VITE_API_KEY=wannabe-production-api-key
