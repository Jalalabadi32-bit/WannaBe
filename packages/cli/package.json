{
  "name": "@wannabe/cli",
  "version": "0.1.0",
  "description": "Headless CLI runner for WANNABE source-to-package verification",
  "type": "module",
  "bin": {
    "wannabe": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "rimraf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@wannabe/core": "*",
    "@wannabe/shared": "*",
    "commander": "^12.0.0"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  }
}
